{
  "title": "webhookd",
  "uid": "webhookd",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ingest rate (events/s)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(webhook_events_ingested_total[1m]))",
          "legendFormat": "events/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Delivery success ratio",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(webhook_delivery_attempts_total{result=\"success\"}[5m])) / sum(rate(webhook_delivery_attempts_total[5m]))",
          "legendFormat": "success"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Dead-lettered (per min)",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(webhook_deliveries_dead_total[5m])) * 60",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Attempts by result / status class",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result, status_class) (rate(webhook_delivery_attempts_total[1m]))",
          "legendFormat": "{{result}} {{status_class}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Attempt duration p50/p99",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(webhook_delivery_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(webhook_delivery_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "End-to-end latency (event \u2192 success) p50/p99",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(webhook_delivery_e2e_latency_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(webhook_delivery_e2e_latency_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Ingest stage latency p99",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, stage) (rate(webhook_ingest_duration_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Ready queue lag + pending",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(webhook_queue_lag)",
          "legendFormat": "total"
        },
        {
          "refId": "B",
          "expr": "max by (shard) (webhook_queue_lag)",
          "legendFormat": "shard {{shard}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Retry backlog",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(webhook_retry_backlog)",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Circuits opened (1h)",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(webhook_circuit_transitions_total{to=\"open\"}[1h])) or vector(0)",
          "legendFormat": "open"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Deferred (no attempt used)",
      "gridPos": {
        "x": 6,
        "y": 32,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(webhook_deliveries_deferred_total[1m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Payload cache",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(webhook_payload_cache_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Object store errors / reconciled",
      "gridPos": {
        "x": 18,
        "y": 32,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (op) (rate(webhook_objectstore_errors_total[5m]))",
          "legendFormat": "s3 {{op}}"
        },
        {
          "refId": "B",
          "expr": "rate(webhook_reconciled_total[5m])",
          "legendFormat": "reconciled"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Worker in-flight",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(webhook_worker_inflight)",
          "legendFormat": "in-flight"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "DLQ notifications",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(webhook_dlq_notifications_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    }
  ]
}